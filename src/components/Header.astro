---
import { navItems, site } from '../data/site';
import { assetPath, sitePath } from '../utils/paths';
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/') || '/';
const activeHref = navItems
  .filter((item) => (item.href === '/' ? currentPath === '/' : currentPath === item.href || currentPath.startsWith(`${item.href}/`)))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<header class="site-header">
  <a class="brand" href={sitePath('/')} aria-label="Homestead Keeper home">
    <img src={assetPath('assets/homestead-keeper-logo.png')} alt="" width="44" height="44" />
    <span>{site.name}</span>
  </a>
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-navigation"
    aria-label="Open menu"
  >
    <span class="nav-toggle-lines" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="nav-toggle-label">Menu</span>
  </button>
  <nav class="main-nav" id="main-navigation" aria-label="Main navigation">
    <ul>
      {navItems.map((item) => {
        const active = item.href === activeHref;
        return <li><a aria-current={active ? 'page' : undefined} href={sitePath(item.href)}>{item.label}</a></li>;
      })}
    </ul>
  </nav>
  <a class="nav-appstore" href={sitePath(site.appStoreUrl)}>{site.appStoreLabel}</a>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('.site-header');
    const toggle = header?.querySelector('.nav-toggle');
    if (!header || !toggle) return;

    const mobileQuery = window.matchMedia('(max-width: 720px)');

    const setMenuOpen = (open) => {
      header.toggleAttribute('data-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      const label = toggle.querySelector('.nav-toggle-label');
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => {
      setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('click', (event) => {
      if (mobileQuery.matches && header.hasAttribute('data-menu-open') && !header.contains(event.target)) {
        setMenuOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-menu-open')) {
        setMenuOpen(false);
        toggle.focus();
      }
    });

    mobileQuery.addEventListener('change', (event) => {
      if (!event.matches) setMenuOpen(false);
    });
  })();
</script>
