---
import Layout from '../layouts/Layout.astro';
import Showcase from './Showcase.astro';
import CTA from './CTA.astro';
import InternalLinkCards from './InternalLinkCards.astro';
import SectionHeader from './SectionHeader.astro';
import { featureLinks, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  h1: string;
  intro: string;
  sections: { title: string; body: string[] }[];
  /** Curated links to informational guides. Feature pages and guides link both ways. */
  guides?: Array<{ title: string; href: string; summary: string }>;
  screenshots: Array<
    | string
    | {
        src: string;
        title: string;
        body: string;
        alt: string;
      }
  >;
}

const { title, description, path, eyebrow, h1, intro, sections, screenshots, guides = [] } = Astro.props;
const related = featureLinks.filter((feature) => feature.href !== path).slice(0, 4);

// Real screens interleaved with each section, alternating sides, instead of a fixed
// narrow sidebar. Screens cycle if there are more sections than screenshots.
const realShots = screenshots.filter((shot): shot is Exclude<typeof screenshots[number], string> => typeof shot !== 'string');
const rows = sections.map((section, index) => ({
  section,
  shot: realShots.length > 0 ? realShots[index % realShots.length] : undefined,
}));

// P3-6: feature pages previously carried no page-level schema while use-case pages did.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${site.url}${path}/#webpage`,
  name: h1,
  description,
  url: `${site.url}${path}/`,
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#application` },
};
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="page-hero narrow">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{h1}</h1>
    <p class="lede">{intro}</p>
  </section>

  <section class="feature-rows">
    {rows.map(({ section, shot }, index) =>
      shot ? (
        <Showcase heading={section.title} body={section.body} src={shot.src} alt={shot.alt} caption={shot.title} reverse={index % 2 === 1} />
      ) : (
        <article class="copy-block feature-row-text-only">
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </article>
      )
    )}
  </section>

  {guides.length > 0 && (
    <section class="section" aria-labelledby="feature-guides-title">
      <SectionHeader
        headingId="feature-guides-title"
        eyebrow="Guides"
        title="Deciding what to record"
        body="Practical guides about which records are worth keeping, written for people working this out for the first time."
      />
      <InternalLinkCards links={guides} />
    </section>
  )}

  <section class="section">
    <p class="eyebrow">Related tools</p>
    <h2>More ways to use {eyebrow.toLowerCase()}</h2>
    <InternalLinkCards links={related} />
  </section>

  <CTA />
</Layout>
