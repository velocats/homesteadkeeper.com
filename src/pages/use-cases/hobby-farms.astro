---
// Retired: consolidated into /use-cases/homestead-management-app/ (65% vocabulary overlap;
// "hobby farm" was an audience synonym, not a distinct search intent). GitHub Pages cannot
// issue a 301, so this uses a canonical + noindex + instant meta refresh, matching the
// /features/supplies/ pattern.
import { sitePath } from '../../utils/paths';
import { site } from '../../data/site';

const target = sitePath('/use-cases/homestead-management-app');
const canonical = `${site.url}/use-cases/homestead-management-app/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
    <title>Moved to Homestead Management App | Homestead Keeper</title>
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <p>This page moved. <a href={target}>Continue to the Homestead Management App page.</a></p>
  </body>
</html>
