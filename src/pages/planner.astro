---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import InternalLinkCards from '../components/InternalLinkCards.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { sitePath } from '../utils/paths';

const title = 'Free Homestead Planner (Printable PDF) | Homestead Keeper';
const description =
  'A free printable homestead planner with seasonal planning, pages for the garden, animals, orchard, and pantry, and reusable record templates. Plan on paper, keep it in the Homestead Keeper app.';

// No email capture. The download is instant. A fire-and-forget beacon notifies us
// (time + IP) on each download; it never blocks or delays the download.
const pdfHref = sitePath('/planner/Homestead-Keeper-Planner.pdf');
const notifyUrl = 'https://formsubmit.co/ajax/support@quiettoolsapps.com';

const whyPlan: [string, string][] = [
  ['See the whole year', "Know what's coming before the season gets busy."],
  ['Nothing slips', 'Sows, sprays, breedings, and reviews all in one place.'],
  ['Plan once', 'Set it up in an afternoon, follow it all year.'],
  ['Grows with you', 'Fine on its own, better with the app.'],
];

const inside: [string, string][] = [
  ['Seasonal planning', 'A year at a glance, a frost-date worksheet, and a reusable monthly page, all worked from your own frost dates.'],
  ['A page for every hub', 'Garden, Animals, Orchard, Food & Pantry, Property, Equipment, Inventory, Emergency Prep, Bees, Off-grid, Forestry, Wildlife & Pests, and Weather & Seasons.'],
  ['Reusable templates', 'Print as many as you need, one per animal, one per planting, one per hive, one per season.'],
];

const templates = [
  'Individual Animal', 'Crop Planting', 'Orchard Planting', 'Breeding Record', 'Hive',
  'Equipment and Asset', 'Pantry and Preservation', 'Inventory Count Sheet',
  'Emergency Prep Checklist', 'Grow Season Overview',
];

const previews = [
  { src: 'planner/preview/01-cover.png', alt: 'Cover of the Homestead Keeper Planner with the barn logo.', title: 'Cover', body: 'A year of planning for your whole homestead.' },
  { src: 'planner/preview/03-homestead-year.png', alt: 'The Homestead Year page, walking through the seasons around your frost dates.', title: 'The Homestead Year', body: 'Season by season, worked from your frost dates.' },
  { src: 'planner/preview/04-garden.png', alt: 'Garden hub page with a plantings table and a season summary box.', title: 'Garden', body: "Plan your Growing Areas and this season's plantings." },
  { src: 'planner/preview/05-template-individual-animal.png', alt: 'The Individual Animal reusable template, with a timeline and a health and weigh-in log.', title: 'Individual Animal template', body: 'Print one per animal.' },
  { src: 'planner/preview/06-take-it-further.png', alt: 'Closing page linking to the Homestead Keeper app.', title: 'Take it further', body: 'Every page maps straight to the app.' },
];

const appLinks = [
  { title: 'All the features', href: '/features', summary: 'See what Homestead Keeper tracks across your whole place.' },
  { title: 'Garden', href: '/features/garden', summary: 'Growing Areas, plantings, and garden timelines in the app.' },
  { title: 'Animals', href: '/features/animals', summary: 'Timelines, breeding, production, and health records.' },
  { title: 'Pricing', href: '/pricing', summary: 'Free to start, Pro when you want more.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'The Homestead Keeper Planner',
  headline: 'Free printable homestead planner',
  description,
  isAccessibleForFree: true,
  inLanguage: 'en',
  encodingFormat: 'application/pdf',
  url: `${site.url}/planner/`,
  author: { '@type': 'Organization', name: site.name, url: site.url },
};
---

<Layout title={title} description={description} path="/planner" jsonLd={jsonLd}>
  <section class="page-hero">
    <p class="eyebrow">Free printable</p>
    <h1>The Homestead Keeper Planner</h1>
    <p class="lede">A year of planning for your whole homestead. Plan it on paper, keep it in the app.</p>
    <div class="button-row">
      <a class="button primary" href={pdfHref} download data-planner-download>Download the free planner</a>
      <a class="button secondary" href={site.appStoreUrl}>{site.appStoreLabel}</a>
    </div>
    <p class="microcopy">Free PDF. No sign-up, no email. Just download and print.</p>
  </section>

  <section class="section">
    <SectionHeader eyebrow="Why plan" title="Plan once, and the season runs smoother." body="A little planning up front means less scrambling when the work piles up. Every page works with a pencil, and nothing here requires the app." />
    <div class="card-grid">
      {whyPlan.map(([t, b]) => <FeatureCard title={t} body={b} />)}
    </div>
  </section>

  <section class="section">
    <SectionHeader eyebrow="What's inside" title="Thirty-two pages for the whole homestead." body="Seasonal planning, a page for every part of your place, and reusable templates you print as many times as you like. Undated, so it works every year." />
    <div class="card-grid">
      {inside.map(([t, b]) => <FeatureCard title={t} body={b} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="preview-title">
    <SectionHeader headingId="preview-title" eyebrow="A look inside" title="See a few pages." body="Click any page to expand it." />
    <ScreenshotGallery shots={previews} />
  </section>

  <section class="section">
    <SectionHeader eyebrow="Reusable templates" title="Print as many as you need." body="Each template matches an add form in the app, so filling it in is the paper version of adding a record." />
    <ul class="check-list">
      {templates.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <section class="section" id="get-the-planner" aria-labelledby="download-title" style="text-align:center;">
    <p class="eyebrow">Free download</p>
    <h2 id="download-title">Download the planner.</h2>
    <p class="lede">No sign-up and no email. It's a printable PDF, undated, so it works season after season. Print the whole thing or just the pages you need.</p>
    <div class="button-row" style="justify-content:center;">
      <a class="button primary" href={pdfHref} download data-planner-download>Download the free planner (PDF)</a>
    </div>
    <p class="microcopy">32 pages, letter size, prints at home.</p>
  </section>

  <CTA
    title="Take it further with Homestead Keeper"
    body="Every page in the planner maps straight to the app, in the same words. Set your frost dates once and it schedules your plantings, keeps each animal's timeline, and reminds you what's due."
    primaryLabel={site.appStoreLabel}
    primaryHref={site.appStoreUrl}
    secondaryLabel="See the features"
    secondaryHref="/features"
  />

  <section class="section">
    <SectionHeader eyebrow="More about the app" title="Keep planning in the app." />
    <InternalLinkCards links={appLinks} />
  </section>
</Layout>

<script define:vars={{ notifyUrl }}>
  // Fire-and-forget download notification. Never blocks or delays the download.
  const links = document.querySelectorAll('[data-planner-download]');
  let sent = false;
  links.forEach((el) => {
    el.addEventListener('click', () => {
      if (sent) return; // avoid double-sends from the two buttons in one visit
      sent = true;
      (async () => {
        let ip = 'unavailable';
        try {
          const r = await fetch('https://api.ipify.org?format=json', { cache: 'no-store' });
          if (r.ok) ip = (await r.json()).ip || 'unavailable';
        } catch (e) { /* ignore */ }
        const now = new Date();
        const payload = {
          _subject: 'Homestead Planner downloaded',
          _template: 'table',
          event: 'Planner PDF download',
          ip_address: ip,
          time_utc: now.toISOString(),
          time_local: now.toString(),
          page: location.href,
          referrer: document.referrer || '(direct)',
          user_agent: navigator.userAgent,
        };
        try {
          await fetch(notifyUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch (e) { /* ignore */ }
      })();
      // The anchor has `download`, so the browser downloads and the page stays put,
      // which lets the async beacon finish.
    });
  });
</script>
