---
import Layout from '../../layouts/Layout.astro';
import InternalLinkCards from '../../components/InternalLinkCards.astro';
import { site } from '../../data/site';

const title = 'Free Printable Garden Planting and Harvest Log | Homestead Keeper';
const description = 'Print a free garden planting and harvest log for crop, variety, bed, seed source, planting dates, care notes, harvest quantities, and an end-of-season review.';
const careRows = Array.from({ length: 5 }, (_, index) => ({ row: index + 1 }));
const harvestRows = Array.from({ length: 6 }, (_, index) => ({ row: index + 1 }));
const exampleCareRows = [
  ['Mar 18, 2026', 'Started indoors', 'Seed-starting mix', '8 seeds; 7 germinated'],
  ['May 22, 2026', 'Transplanted', 'Compost added at planting', '4 plants; spaced 24 in. apart'],
  ['Jun 14, 2026', 'Tied to supports', 'None', 'First flowers open'],
  ['Jul 03, 2026', 'Lower leaves spotted', 'Removed affected leaves', 'Watch new growth; no recommendation implied'],
];
const exampleHarvestRows = [
  ['Aug 05, 2026', '3.0', 'lb', 'Sauce', 'First full harvest'],
  ['Aug 12, 2026', '4.5', 'lb', 'Sauce', 'Even ripening'],
  ['Aug 20, 2026', '5.0', 'lb', 'Fresh and sauce', 'Two split fruit used immediately'],
  ['Aug 29, 2026', '3.5', 'lb', 'Sauce', '16.0 lb total so far'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Garden Planting and Harvest Log',
  description,
  isAccessibleForFree: true,
  inLanguage: 'en',
  url: `${site.url}/planner/garden-planting-harvest-log/`,
  author: { '@id': `${site.url}/#organization` },
};
---

<Layout title={title} description={description} path="/planner/garden-planting-harvest-log/" jsonLd={jsonLd}>
  <section class="page-hero narrow no-print">
    <p class="eyebrow">Free printable garden record</p>
    <h1>Garden planting and harvest log</h1>
    <p class="lede">Keep one crop or variety on each sheet. Record where it grew, when it went in, the care notes worth remembering, and what it produced.</p>
    <div class="button-row">
      <button class="button primary" type="button" data-print-log>Print the blank log</button>
      <a class="button secondary" href="#completed-example">See a completed example</a>
    </div>
    <p class="microcopy">No sign-up. Prints on one letter-size page in landscape orientation.</p>
  </section>

  <section class="print-sheet" aria-labelledby="blank-log-title">
    <header class="sheet-header">
      <div><p class="sheet-kicker">Homestead Keeper printable</p><h2 id="blank-log-title">Garden Planting and Harvest Log</h2></div>
      <p>Season / year: <span class="write-line"></span></p>
    </header>
    <div class="crop-fields">
      <p>Crop: <span class="write-line"></span></p><p>Variety: <span class="write-line"></span></p><p>Bed / area: <span class="write-line"></span></p>
      <p>Seed or plant source: <span class="write-line wide"></span></p><p>Method: □ direct-seeded &nbsp; □ transplanted</p>
    </div>
    <h3>Planting and care notes</h3>
    <div class="table-wrap sheet-table-wrap care-table">
      <table><thead><tr><th scope="col">#</th><th scope="col">Date</th><th scope="col">Action or observation</th><th scope="col">Amendment or response</th><th scope="col">Notes</th></tr></thead>
        <tbody>{careRows.map((row) => <tr><td>{row.row}</td><td></td><td></td><td></td><td></td></tr>)}</tbody></table>
    </div>
    <h3>Harvest record</h3>
    <div class="table-wrap sheet-table-wrap harvest-table">
      <table><thead><tr><th scope="col">#</th><th scope="col">Date</th><th scope="col">Quantity</th><th scope="col">Unit</th><th scope="col">Use or quality</th><th scope="col">Notes</th></tr></thead>
        <tbody>{harvestRows.map((row) => <tr><td>{row.row}</td><td></td><td></td><td></td><td></td><td></td></tr>)}</tbody></table>
    </div>
    <div class="review-fields"><p><strong>What worked:</strong> <span></span></p><p><strong>Change next season:</strong> <span></span></p></div>
    <footer class="sheet-footer">homesteadkeeper.com · Use the same unit for every harvest so the season total stays comparable.</footer>
  </section>

  <section class="section no-print" id="completed-example" aria-labelledby="example-title">
    <p class="eyebrow">Completed example</p>
    <h2 id="example-title">Roma tomatoes in Raised Bed 2</h2>
    <p>This example shows the level of detail that can still be useful next spring. The dates and observations illustrate record keeping; they are not planting-date or treatment recommendations.</p>
    <dl class="example-summary"><div><dt>Crop and variety</dt><dd>Tomato · Roma VF</dd></div><div><dt>Bed / area</dt><dd>Raised Bed 2</dd></div><div><dt>Source and method</dt><dd>Saved seed · transplanted</dd></div></dl>
    <h3>Planting and care</h3>
    <div class="table-wrap example-table-wrap"><table><thead><tr><th scope="col">Date</th><th scope="col">Action or observation</th><th scope="col">Amendment or response</th><th scope="col">Notes</th></tr></thead><tbody>{exampleCareRows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>
    <h3>Harvests</h3>
    <div class="table-wrap example-table-wrap"><table><thead><tr><th scope="col">Date</th><th scope="col">Quantity</th><th scope="col">Unit</th><th scope="col">Use or quality</th><th scope="col">Notes</th></tr></thead><tbody>{exampleHarvestRows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>
    <p><strong>Season note:</strong> The four recorded harvests totaled 16.0 lb. Next season, keep the supports ready before transplanting and compare yield using pounds again.</p>
  </section>

  <section class="section soft-panel no-print" aria-labelledby="next-title">
    <h2 id="next-title">Carry the record into next season</h2>
    <p>Homestead Keeper connects each planting to its growing area, timeline, care notes, and harvests, so the result stays useful when you plan the bed again.</p>
    <InternalLinkCards links={[
      { title: 'What garden records should you keep?', href: '/guides/what-records-to-keep-for-a-vegetable-garden/', summary: 'Learn which four garden records earn their place during the busy season.' },
      { title: 'Garden records in Homestead Keeper', href: '/features/garden/', summary: 'See growing areas, crop placement, planting records, harvests, and season reports.' },
      { title: 'Garden layout and planting workflow', href: '/workflows/garden-layout-plantings/', summary: 'Follow the in-app workflow for mapping beds and recording plantings.' },
    ]} />
  </section>
</Layout>

<script>document.querySelector('[data-print-log]')?.addEventListener('click', () => window.print());</script>

<style>
  .print-sheet { width: min(100% - 2rem, 11in); margin: 1rem auto 3rem; padding: clamp(1.15rem, 3vw, 2rem); color: #243122; background: #fffdf8; border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .sheet-header, .crop-fields { display: flex; align-items: end; justify-content: space-between; gap: 0.8rem; flex-wrap: wrap; }
  .sheet-header h2 { margin: 0; font-size: clamp(1.45rem, 3.8vw, 2.1rem); }
  .sheet-kicker { margin: 0 0 0.2rem; color: var(--ink); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .write-line { display: inline-block; min-width: 6rem; height: 1.15rem; border-bottom: 1px solid currentColor; vertical-align: bottom; }
  .write-line.wide { min-width: 9rem; }
  .print-sheet h3 { margin: 0.75rem 0 0.35rem; font-size: 0.95rem; }
  .sheet-table-wrap { border-color: #79826d; box-shadow: none; background: white; }
  .sheet-table-wrap table, .example-table-wrap table { min-width: 760px; font-size: 0.79rem; }
  .sheet-table-wrap th, .sheet-table-wrap td { height: 1.7rem; border-color: #aeb5a6; color: #243122; }
  .sheet-table-wrap thead th { background: #e9eedf; }
  .review-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 0.65rem; }
  .review-fields p { margin: 0; }
  .review-fields span { display: block; height: 1.3rem; border-bottom: 1px solid #aeb5a6; }
  .sheet-footer { margin-top: 0.55rem; color: #687062; font-size: 0.72rem; text-align: center; }
  .example-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-block: 1.25rem; }
  .example-summary div { padding: 1rem; background: var(--surface); border: 1px solid var(--line); }
  .example-summary dt { color: var(--ink); font-weight: 800; }
  .example-summary dd { margin: 0.25rem 0 0; }
  .example-table-wrap { margin-block: 0.5rem 1.5rem; }
  @media (max-width: 760px) { .sheet-header { align-items: start; flex-direction: column; } .print-sheet { width: calc(100% - 1rem); padding: 1rem; } .example-summary { grid-template-columns: 1fr; } }
  @media print {
    @page { size: letter landscape; margin: 0.25in; }
    :global(body) { background: white; }
    :global(.site-header), :global(.site-footer), :global(.breadcrumbs), :global(.screenshot-lightbox), .no-print { display: none !important; }
    .print-sheet { width: 100%; margin: 0; padding: 0; border: 0; box-shadow: none; }
    .sheet-table-wrap { overflow: visible; }
    .sheet-table-wrap table { min-width: 0; table-layout: fixed; font-size: 7pt; }
    .sheet-table-wrap th, .sheet-table-wrap td { height: 0.25in; padding: 0.035in; }
    .care-table th:nth-child(1), .harvest-table th:nth-child(1) { width: 5%; }
    .care-table th:nth-child(2) { width: 12%; } .care-table th:nth-child(3) { width: 25%; } .care-table th:nth-child(4) { width: 25%; }
    .harvest-table th:nth-child(2) { width: 14%; } .harvest-table th:nth-child(3), .harvest-table th:nth-child(4) { width: 12%; } .harvest-table th:nth-child(5) { width: 23%; }
  }
</style>
