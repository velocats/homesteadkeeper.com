---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import InternalLinkCards from '../../components/InternalLinkCards.astro';
import TutorialCard from '../../components/TutorialCard.astro';
import { guides } from '../../data/guides';
import { site } from '../../data/site';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const url = `${site.url}/guides/${guide.slug}/`;

const otherGuides = guides
  .filter((item) => item.slug !== guide.slug)
  .map((item) => ({
    title: item.h1,
    href: `/guides/${item.slug}`,
    summary: item.answer,
  }));

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: guide.h1,
  description: guide.description,
  url,
  mainEntityOfPage: url,
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  isPartOf: { '@id': `${site.url}/#website` },
  about: guide.keywords,
};

// VideoObject is only emitted when a real embedded video is present on the page.
const jsonLd: Record<string, unknown>[] = [articleLd];
if (guide.video) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    '@id': `${url}#video`,
    name: guide.video.title,
    description: guide.video.description,
    embedUrl: `https://www.youtube-nocookie.com/embed/${guide.video.videoId}`,
    contentUrl: `https://www.youtube.com/watch?v=${guide.video.videoId}`,
    thumbnailUrl: `https://i.ytimg.com/vi/${guide.video.videoId}/hqdefault.jpg`,
    publisher: { '@id': `${site.url}/#organization` },
  });
}
---

<Layout title={guide.title} description={guide.description} path={`/guides/${guide.slug}`} jsonLd={jsonLd}>
  <section class="page-hero narrow">
    <p class="eyebrow">{guide.eyebrow}</p>
    <h1>{guide.h1}</h1>
    <p class="lede">{guide.intro}</p>
  </section>

  <section class="section soft-panel" aria-labelledby="short-answer-title">
    <p class="eyebrow">Short answer</p>
    <h2 id="short-answer-title">The short version</h2>
    <p>{guide.answer}</p>
  </section>

  <section class="split-section">
    <div>
      {guide.sections.map((section) => (
        <article class="copy-block">
          <h2>{section.title}</h2>
          {section.body?.map((paragraph) => <p>{paragraph}</p>)}
          {section.list && (
            <ul class="check-list">
              {section.list.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
    <aside class="sidebar-stack">
      <article class="info-card">
        <p class="eyebrow">Scope</p>
        <h3>What this guide does not cover</h3>
        <p>{guide.limitation}</p>
      </article>
      <article class="info-card">
        <p class="eyebrow">Apple devices</p>
        <h3>Records where the work happens</h3>
        <p>Homestead Keeper runs on iPhone, iPad, and Mac with records stored on your devices, so entries can be made in the barn, garden, or shop without a signal.</p>
      </article>
      <article class="info-card">
        <p class="eyebrow">Start on paper</p>
        <h3>Free printable planner</h3>
        <p>If you would rather sketch a system out by hand first, the <a class="text-link" href="/planner/">free homestead planner</a> has seasonal pages and reusable record templates.</p>
      </article>
    </aside>
  </section>

  {guide.video && (
    <section class="section" aria-labelledby="video-title">
      <SectionHeader
        headingId="video-title"
        eyebrow="Walkthrough"
        title="See it in the app"
        body="A short walkthrough of how this works in Homestead Keeper."
      />
      <div class="video-grid">
        <TutorialCard
          videoId={guide.video.videoId}
          title={guide.video.title}
          iframeTitle={guide.video.iframeTitle}
          description={guide.video.description}
        />
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="related-title">
    <SectionHeader headingId="related-title" eyebrow="Related" title="Tools and workflows for this work" />
    <InternalLinkCards links={guide.related} />
  </section>

  <section class="section" aria-labelledby="more-guides-title">
    <SectionHeader headingId="more-guides-title" eyebrow="More guides" title="Other record-keeping guides" />
    <InternalLinkCards links={otherGuides} />
  </section>

  <CTA
    title="Keep these records in one place"
    body="Homestead Keeper brings animal, garden, equipment, inventory, and maintenance records together on iPhone, iPad, and Mac. Start free with up to 20 items."
  />
</Layout>
