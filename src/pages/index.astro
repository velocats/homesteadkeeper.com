---
import Layout from '../layouts/Layout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import CTA from '../components/CTA.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Showcase from '../components/Showcase.astro';
import InternalLinkCards from '../components/InternalLinkCards.astro';
import { appStoreReviews, managementAreas, site, trustPoints } from '../data/site';
import { assetPath, sitePath } from '../utils/paths';

const title = 'Homestead Management and Record-Keeping App | Homestead Keeper';
const description = 'Homestead Keeper keeps chores, animals, gardens, inventory, maintenance, reminders, and reports together on iPhone, iPad, and Mac.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${site.url}/#application`,
  name: site.appStoreName,
  alternateName: site.name,
  url: site.url,
  image: `${site.url}/assets/screenshots/homestead-hub.webp`,
  downloadUrl: site.appStoreUrl,
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'iOS, iPadOS, macOS',
  publisher: { '@id': `${site.url}/#organization` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free' },
  description,
};
// Each block leads with a real screen from the app rather than an icon and a claim.
const showcases = [
  {
    tabLabel: 'Homestead Hub',
    heading: 'Know what needs attention today.',
    body: [
      'The Homestead Hub keeps the parts of the place you actually manage in one view, so a morning check does not mean opening four different lists.',
      'Overdue work, upcoming reminders, and recent field notes surface first.',
    ],
    src: 'assets/screenshots/homestead-hub.webp',
    alt: 'Homestead Keeper Homestead Hub showing featured Garden, Animals, Property, and Inventory cards plus Orchard, Bees, Equipment, Food & Pantry, Off-grid, Weather & Seasons, Forestry, and Emergency Prep.',
    caption: 'Homestead Hub — the areas you manage, in one place.',
    href: '/features',
    linkLabel: 'See all features',
  },
  {
    tabLabel: 'Garden layouts',
    heading: 'See what is planted where.',
    body: [
      'Garden bed layouts map crops to real beds and paths by season, so next spring you know what grew where without relying on memory.',
      'Layouts connect to planting records and harvest history for the same bed.',
    ],
    src: 'assets/screenshots/garden-bed-layout.webp',
    alt: 'Garden bed layout showing a raised bed with beets, bell peppers, paths, Swiss chard, and radicchio assigned to grid cells.',
    caption: 'Garden bed layout — crop placement by bed and season.',
    href: '/features/garden',
    linkLabel: 'Garden records and bed layouts',
  },
  {
    tabLabel: 'Maintenance',
    heading: 'Find the maintenance history when something breaks.',
    body: [
      'Service, repair, and inspection records stay with the machine or system they belong to, and roll up into a maintenance overview with costs and overdue work.',
      'That history is what turns a repair-or-replace decision into arithmetic.',
    ],
    src: 'assets/screenshots/report-maintenance.webp',
    alt: 'Maintenance Overview report showing a health score, overview metrics, a logbook trend chart, upcoming care, and a watchlist.',
    caption: 'Maintenance Overview — completed work, costs, and what is overdue.',
    href: '/features/equipment',
    linkLabel: 'Equipment maintenance records',
  },
];
---

<Layout title={title} description={description} path="/" image="/assets/screenshots/homestead-hub.webp" jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Homestead records for Apple devices</p>
      <h1 id="hero-title">Keep your homestead in good order.</h1>
      <p class="hero-lede">One homestead management app for animals, gardens, chores, equipment, and supplies—on iPhone, iPad, and Mac.</p>
      <div class="button-row">
        <AppStoreBadge height={46} />
        <a class="button secondary" href={sitePath('/features')}>See how it works</a>
      </div>
      <p class="microcopy">Try it free. No account required. Local-first with optional iCloud sync.</p>
    </div>
    <figure class="hero-product">
      <button
        class="screenshot-trigger"
        type="button"
        data-lightbox-src={assetPath('assets/screenshots/homestead-hub.webp')}
        data-lightbox-alt={showcases[0].alt}
        data-lightbox-title={showcases[0].caption}
        aria-label={`Expand screenshot: ${showcases[0].caption}`}
      >
        <img
          src={assetPath('assets/screenshots/homestead-hub-800.webp')}
          srcset={`${assetPath('assets/screenshots/homestead-hub-480.webp')} 480w, ${assetPath('assets/screenshots/homestead-hub-800.webp')} 800w, ${assetPath('assets/screenshots/homestead-hub-1200.webp')} 1200w`}
          sizes="(max-width: 900px) calc(100vw - 4rem), min(42vw, 500px)"
          alt={showcases[0].alt}
          width="800"
          height="1067"
          loading="eager"
          decoding="async"
        />
      </button>
      <figcaption>Today’s work and every part of the place, together.</figcaption>
    </figure>
  </section>

  <ul class="trust-line" aria-label="Privacy and sync highlights">
    {trustPoints.map(([title]) => <li><strong>{title}</strong></li>)}
  </ul>

  <section class="workflow-intro section" aria-labelledby="workflow-title">
    <SectionHeader
      headingId="workflow-title"
      eyebrow="Built for the work"
      title="A clearer record of what happened, what is next, and where everything belongs."
    />
  </section>

  <div class="home-workflows">
    {showcases.map((screen, index) => (
      <Showcase
        heading={screen.heading}
        body={screen.body}
        src={screen.src}
        alt={screen.alt}
        caption={screen.caption}
        href={screen.href}
        linkLabel={screen.linkLabel}
        reverse={index % 2 === 1}
      />
    ))}
  </div>

  <section class="section fit-section" aria-labelledby="find-your-fit-title">
    <SectionHeader headingId="find-your-fit-title" title="Start with the work you do every day." />
    <InternalLinkCards links={[
      { title: 'Chicken records and egg tracking', href: '/use-cases/chicken-keepers/', summary: 'Keep egg counts, feed notes, flock history, and coop care together.' },
      { title: 'Garden planning and harvest records', href: '/use-cases/gardeners/', summary: 'Connect bed layouts to planting dates, harvests, and next season’s plans.' },
      { title: 'Homestead chores and reminders', href: '/use-cases/homestead-task-tracker/', summary: 'See daily chores, recurring work, and overdue tasks beside the records they belong to.' },
    ]} />
  </section>

  <section class="section areas-section" aria-labelledby="areas-title">
    <SectionHeader
      headingId="areas-title"
      eyebrow="One app"
      title="Built for mixed work, not one crop or one animal."
      body="Turn on the areas you actually use and hide the rest. Most homesteads need several of these at once, which is why they live in one app rather than five."
    />
    <ul class="area-list">
      {managementAreas.map(([title]) => <li>{title}</li>)}
    </ul>
  </section>

  <section class="section reviews-section" aria-labelledby="reviews-title">
    <SectionHeader
      headingId="reviews-title"
      eyebrow="App Store reviews"
      title="What early users say."
      body="Recent reviews from the U.S. Apple App Store. Reviewer handles are partially hidden for privacy."
    />
    <ul class="review-lines">
      {appStoreReviews.map((review) => (
        <li>
          <span class="review-stars" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
          <blockquote>“{review.excerpt}”</blockquote>
          <cite>{review.title} · {review.reviewer} · {review.date}</cite>
        </li>
      ))}
    </ul>
    <p class="review-source">Reviews from the U.S. Apple App Store. <a class="text-link" href={site.appStoreUrl}>View Homestead Keeper on the App Store</a>.</p>
  </section>

  <CTA
    title="Start with twenty records and see if it fits."
    body="Free covers up to 20 items with reminders, calendar views, and field notes, plus a demo homestead to explore first. No account required."
    secondaryLabel="View pricing"
    secondaryHref="/pricing"
  />
</Layout>
