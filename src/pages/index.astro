---
import Layout from '../layouts/Layout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Showcase from '../components/Showcase.astro';
import { appStoreReviews, newFeatures, site } from '../data/site';
import { assetPath, sitePath } from '../utils/paths';

const title = 'Homestead Management and Record-Keeping App | Homestead Keeper';
const description = 'Homestead Keeper keeps chores, animals, gardens, inventory, maintenance, reminders, and reports together on iPhone, iPad, and Mac.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${site.url}/#application`,
  name: site.appStoreName,
  alternateName: site.name,
  url: site.url,
  image: `${site.url}/assets/screenshots/homestead-hub.webp`,
  downloadUrl: site.appStoreUrl,
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'iOS, iPadOS, macOS',
  publisher: { '@id': `${site.url}/#organization` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free' },
  description,
};
const hubAlt = 'Homestead Hub with Garden, Animals, Property, Inventory, and other areas of a homestead together.';
const showcases = [
  {
    heading: 'Know what needs doing.',
    body: [
      'See today’s chores, overdue work, and upcoming reminders together. Keep daily care and seasonal maintenance beside the records they belong to.',
    ],
    src: 'assets/workflows/today/Simulator Screenshot - iPad Air 13-inch (M3) - 2026-06-26 at 10.25.12.webp',
    alt: 'Today screen showing overdue work, daily egg and water checks, field log actions, and crops needing attention.',
    caption: 'See today’s work in one place.',
    href: '/use-cases/homestead-task-tracker/',
    linkLabel: 'Chores and reminders',
  },
  {
    heading: 'Know what happened last time.',
    body: [
      'Keep the repair history with the equipment, so you can check the last service and what you’ve spent before deciding to repair or replace it.',
      'The same useful memory carries through planting seasons, animal care, and property work.',
    ],
    src: 'assets/screenshots/report-maintenance.webp',
    alt: 'Maintenance Overview showing completed records, overdue reminders, service costs, a logbook trend, and a watchlist.',
    caption: 'Look back at completed work and costs before the next repair.',
    href: '/features/equipment/',
    linkLabel: 'Equipment maintenance records',
  },
  {
    heading: 'Know where everything is.',
    body: [
      'Keep supplies, equipment, and related records organized by real places, from the coop to the pump house.',
      'Map boundaries, pastures, and fence lines alongside your property records. A Property Handoff report helps someone else find their way, too.',
    ],
    src: 'assets/screenshots/report-handoff-boundaries.webp',
    alt: 'Property Handoff report with a satellite map and linked records for the property line, back pasture, chicken yard, and north fence.',
    caption: 'Keep the map and the records for each place together.',
    href: '/workflows/map-usage/',
    linkLabel: 'Property maps and linked records',
  },
];
---

<Layout title={title} description={description} path="/" image="/assets/screenshots/homestead-hub.webp" jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Homestead management app</p>
      <h1 id="hero-title">Your whole homestead. One place to keep track of it.</h1>
      <p class="hero-lede">Animals, gardens, chores, equipment, supplies, maintenance, and property records together, without juggling separate apps and scattered notes.</p>
      <div class="button-row">
        <a class="button primary" href={site.appStoreUrl}>Download free on the App Store</a>
        <a class="text-link" href="#how-it-works">See how it works</a>
      </div>
      <p class="microcopy">Free to try • No account • Works offline • iPhone, iPad &amp; Mac</p>
    </div>
    <figure class="hero-product">
      <button
        class="screenshot-trigger"
        type="button"
        data-lightbox-src={assetPath('assets/screenshots/homestead-hub.webp')}
        data-lightbox-alt={hubAlt}
        data-lightbox-title={'Every part of your homestead, together.'}
        aria-label={`Expand screenshot: ${'Every part of your homestead, together.'}`}
      >
        <img
          src={assetPath('assets/screenshots/homestead-hub-800.webp')}
          srcset={`${assetPath('assets/screenshots/homestead-hub-480.webp')} 480w, ${assetPath('assets/screenshots/homestead-hub-800.webp')} 800w, ${assetPath('assets/screenshots/homestead-hub-1200.webp')} 1200w`}
          sizes="(max-width: 900px) calc(100vw - 4rem), min(42vw, 500px)"
          alt={hubAlt}
          width="800"
          height="1067"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </button>
      <figcaption>Every part of your homestead, together.</figcaption>
    </figure>
  </section>

  <section class="section fragmentation" aria-labelledby="fragmentation-title">
    <h2 id="fragmentation-title">A homestead doesn’t fit neatly into one category.</h2>
    <div>
      <p>Chicken records in one app. Garden notes in a spreadsheet. Maintenance in a notebook. Chores in Reminders. Property details spread across photos and files.</p>
      <p>Homestead Keeper brings that work together, with one place to check what’s next and look back at what you’ve done.</p>
    </div>
  </section>

  <div class="home-workflows" id="how-it-works">
    {showcases.map((screen, index) => (
      <Showcase
        heading={screen.heading}
        body={screen.body}
        src={screen.src}
        alt={screen.alt}
        caption={screen.caption}
        href={screen.href}
        linkLabel={screen.linkLabel}
        reverse={index % 2 === 1}
      />
    ))}
  </div>

  <section class="section areas-section" aria-labelledby="areas-title">
    <SectionHeader
      headingId="areas-title"
      eyebrow="For the place you actually keep"
      title="Built for mixed work, not one crop or one animal."
      body="A few chickens and garden beds, a small homestead, or rural acreage with an orchard and off-grid systems. Turn on the areas you use and hide the rest."
    />
    <ul class="fit-links">
      <li><a href={sitePath('/use-cases/chicken-keepers/')}>Chicken keepers</a></li>
      <li><a href={sitePath('/use-cases/gardeners/')}>Gardeners</a></li>
      <li><a href={sitePath('/use-cases/hobby-farms/')}>Hobby farms</a></li>
      <li><a href={sitePath('/use-cases/rural-property-owners/')}>Rural properties</a></li>
    </ul>
  </section>

  <section class="section reviews-section" aria-labelledby="reviews-title">
    <SectionHeader
      headingId="reviews-title"
      eyebrow="App Store reviews"
      title="What early users say."
      body="Reviews from the U.S. Apple App Store. Reviewer handles are partially hidden for privacy."
    />
    <ul class="review-lines">
      {appStoreReviews.map((review) => (
        <li>
          <span class="review-stars" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
          <blockquote>“{review.excerpt}”</blockquote>
          <cite>{review.title} · {review.reviewer} · {review.date}</cite>
        </li>
      ))}
    </ul>
    <p class="review-source">Reviews from the U.S. Apple App Store. <a class="text-link" href={site.appStoreUrl}>View Homestead Keeper on the App Store</a>.</p>
  </section>

  <section class="section home-pricing" aria-labelledby="pricing-title">
    <SectionHeader headingId="pricing-title" eyebrow="Simple pricing" title="Try it free." />
    <div class="home-price-grid">
      <article class="home-price">
        <h3>Free</h3>
        <p class="price-amount">$0</p>
        <p>Up to 20 total items, with reminders, calendar views, and field notes.</p>
      </article>
      <article class="home-price pro-price">
        <h3>Pro</h3>
        <p>Unlimited items and the full Pro toolkit.</p>
        <p class="annual-price">$19.99/year <span>or</span></p>
        <p class="price-amount">$39.99 <span>lifetime</span></p>
        <p class="fine-print">One purchase. No renewal.</p>
      </article>
    </div>
    <div class="pricing-notes">
      <p>No account required. Records stay on your devices, work offline, and sync through iCloud when enabled.</p>
      <p>If a subscription ends, existing records stay visible. Paid actions require Pro again.</p>
      <p class="fine-print">U.S. App Store prices. Regional prices and taxes may vary. Monthly Pro is also available.</p>
      <a class="text-link" href={sitePath('/pricing/')}>Full pricing and Pro details</a>
    </div>
  </section>

  <section class="section home-updates" aria-labelledby="new-features-title">
    <SectionHeader
      headingId="new-features-title"
      eyebrow="New in Homestead Keeper"
      title="Herds, property boundaries, and more."
      body="Built from requests from people using the app. Open an update for details."
    />
    <div class="update-list">
      {newFeatures.map((feature) => (
        <details>
          <summary>{feature.title}</summary>
          <p>{feature.body}</p>
          <a class="text-link" href={sitePath(feature.href)}>More about {feature.title.toLowerCase()}</a>
        </details>
      ))}
    </div>
    <p><a class="text-link" href={sitePath('/support/')}>Send a feature request</a></p>
  </section>

  <section class="cta-band home-download" aria-labelledby="cta-title">
    <div>
      <h2 id="cta-title">Keep your homestead records in one place.</h2>
      <p>Free to try. No account. For iPhone, iPad, and Mac.</p>
    </div>
    <div class="download-action">
      <a class="download-label" href={site.appStoreUrl}>Download free on the App Store</a>
      <AppStoreBadge height={46} />
    </div>
  </section>
</Layout>

<style>
  .hero { margin-top: 1.5rem; padding-block: 2rem; }
  .hero-copy { display: grid; }
  .hero-copy > * { order: initial; }
  .hero-copy h1 { max-width: 17ch; font-size: clamp(2.25rem, 4.6vw, 3.75rem); }
  .hero .button-row { gap: 1rem 1.5rem; }
  .hero .button.primary { text-align: center; }
  .hero-product { padding: clamp(1rem, 2.5vw, 2rem); }
  .hero-product img { height: auto; width: 340px; max-width: 100%; }
  .fragmentation { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; border-block: 1px solid var(--line); margin-top: 2rem; }
  .fragmentation h2 { max-width: 23ch; }
  .fragmentation p + p { margin-top: 1rem; }
  #how-it-works { scroll-margin-top: 6rem; }
  .home-workflows :global(.showcase) { min-height: auto; }
  .home-workflows :global(.showcase-figure img) { max-width: 100%; }
  .fit-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; list-style: none; }
  .fit-links a { color: var(--brand); text-decoration: underline; text-underline-offset: 0.2em; }
  .home-price-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .home-price { display: grid; align-content: start; gap: 0.75rem; border: 1px solid var(--line); border-radius: 1.5rem; padding: clamp(1.5rem, 3vw, 2.5rem); }
  .pro-price { background: var(--surface-2); border-color: var(--brand); }
  .price-amount { font-size: clamp(2rem, 4vw, 2.75rem); font-weight: var(--fw-semibold); color: var(--ink); line-height: 1.2; }
  .price-amount span { font-size: 1.25rem; }
  .annual-price { font-size: 1.25rem; color: var(--ink); }
  .annual-price span { margin-left: 0.5rem; color: var(--muted); font-size: 1rem; }
  .pricing-notes { display: grid; gap: 0.65rem; max-width: 78ch; }
  .update-list details { border-top: 1px solid var(--line); padding-block: 1rem; }
  .update-list details:last-child { border-bottom: 1px solid var(--line); }
  .update-list summary { cursor: pointer; font-weight: var(--fw-semibold); color: var(--ink); }
  .update-list p { margin-block: 0.75rem; max-width: 75ch; }
  .download-action { display: grid; gap: 0.75rem; justify-items: start; }
  .download-label { color: var(--surface); font-weight: var(--fw-semibold); text-decoration: underline; text-underline-offset: 0.2em; }
  .home-download a:focus-visible { outline-color: var(--surface); }
  @media (max-width: 1020px) {
    .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 1.5rem; }
  }
  @media (max-width: 720px) {
    .hero { grid-template-columns: minmax(0, 1fr); margin-top: 0; padding-top: 1.5rem; }
    .hero-copy { gap: 1rem; }
    .hero-copy > * { order: initial; }
    .hero-copy h1 { max-width: 19ch; }
    .hero-lede { font-size: 1.0625rem; }
    .hero .button-row { align-items: flex-start; }
    .fragmentation, .home-price-grid { grid-template-columns: minmax(0, 1fr); }
    .fragmentation { gap: 1rem; }
    .home-price { padding: 1.5rem; }
  }
</style>
