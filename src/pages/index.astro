---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site, trustPoints } from '../data/site';
import { sitePath } from '../utils/paths';

const title = 'Homestead Management App for Apple Devices | Homestead Keeper';
const description = 'Homestead Keeper keeps chores, animals, gardens, inventory, maintenance, reminders, and reports together on iPhone, iPad, and Mac.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${site.url}/#application`,
  name: site.name,
  url: site.url,
  image: `${site.url}/assets/screenshots/homestead-hub.webp`,
  downloadUrl: site.appStoreUrl,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'iOS, iPadOS, macOS',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free' },
  description,
};
const highlights = [
  ['Keep the whole homestead together', 'Track chores, animals, gardens, equipment, property, inventory, pantry records, and seasonal work in one app.'],
  ['See what needs attention', 'Use Today, reminders, calendars, inventory alerts, and reports to keep daily work visible.'],
  ['Own your records', 'No Homestead Keeper account is required. Work offline and optionally sync across your Apple devices with iCloud.'],
];
---

<Layout title={title} description={description} path="/" image="/assets/screenshots/homestead-hub.webp" jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Homestead records for Apple devices</p>
      <h1 id="hero-title">Run your homestead without scattered notes and spreadsheets.</h1>
      <p class="hero-lede">Homestead Keeper brings tasks, animals, gardens, inventory, maintenance, and property records together on iPhone, iPad, and Mac.</p>
      <div class="button-row">
        <a class="button primary" href={site.appStoreUrl}>Download on the App Store</a>
        <a class="button secondary" href={sitePath('/more-info')}>More Info</a>
      </div>
      <p class="microcopy">Try it free. No account required. Local-first with optional iCloud sync.</p>
    </div>
    <ScreenshotFrame src="assets/screenshots/homestead-hub.webp" alt="Homestead Keeper Homestead Hub showing Garden, Animals, Property, Inventory, and More to Manage cards." caption="The major parts of your homestead in one calm place." loading="eager" />
  </section>

  <section class="trust-strip" aria-label="Privacy and sync highlights">
    {trustPoints.map(([title, body]) => (
      <article>
        <strong>{title}</strong>
        <span>{body}</span>
      </article>
    ))}
  </section>

  <section class="section home-summary" aria-labelledby="summary-title">
    <SectionHeader
      headingId="summary-title"
      eyebrow="One app"
      title="The short version."
      body="Homestead Keeper is built for the mixed work of a backyard homestead, hobby farm, or rural property."
    />
    <div class="card-grid compact">
      {highlights.map(([title, body]) => <FeatureCard title={title} body={body} />)}
    </div>
  </section>

  <CTA
    title="Want screenshots, reviews, features, workflows, and tutorials?"
    body="The detailed product tour now lives in one place, so the home page can stay simple."
    primaryLabel="More Info"
    primaryHref="/more-info"
    secondaryLabel="View pricing"
    secondaryHref="/pricing"
  />
</Layout>
