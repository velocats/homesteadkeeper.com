---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import InternalLinkCards from '../components/InternalLinkCards.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../data/site';

const title = 'About Homestead Keeper and Quiet Tools LLC';
const description = 'Learn who publishes Homestead Keeper, the product principles behind the app, how its documentation is maintained, and how to request support or corrections.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${site.url}/about/#webpage`,
  name: title,
  description,
  url: `${site.url}/about/`,
  isPartOf: { '@id': `${site.url}/#website` },
  about: [
    { '@id': `${site.url}/#organization` },
    { '@id': `${site.url}/#application` },
  ],
};
---

<Layout title={title} description={description} path="/about" jsonLd={jsonLd}>
  <section class="page-hero narrow">
    <p class="eyebrow">About</p>
    <h1>Practical software for keeping a working homestead organized.</h1>
    <p class="lede">Homestead Keeper is developed and published by Quiet Tools LLC. It brings animals, gardens, inventory, equipment maintenance, reminders, and property records together without requiring a Homestead Keeper web account.</p>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <SectionHeader
      headingId="principles-title"
      eyebrow="Product principles"
      title="Designed around useful records, privacy, and real work."
      body="Homestead Keeper is built for backyard homesteads, hobby farms, and rural properties that need more structure than scattered notes without the complexity of enterprise farm software."
    />
    <div class="card-grid">
      <article class="card"><h3>Local-first</h3><p>Working records live on your Apple devices. Optional iCloud sync uses your Apple ID to keep supported devices current.</p></article>
      <article class="card"><h3>No required account</h3><p>Normal use does not require a Homestead Keeper login or a separate browser dashboard.</p></article>
      <article class="card"><h3>Whole-homestead context</h3><p>Records can stay connected to the animal, bed, tool, building, system, supply, or place they belong to.</p></article>
    </div>
  </section>

  <section class="split-section soft-panel">
    <div>
      <p class="eyebrow">Documentation</p>
      <h2>Product guidance is reviewed against the app.</h2>
      <p>Website descriptions, pricing, tutorials, and workflows are maintained by Quiet Tools LLC and are intended to reflect the current Homestead Keeper release. Screenshots and demonstration records are used to show how features work without exposing a customer’s private homestead data.</p>
      <p>Homestead Keeper organizes records. It is not a substitute for veterinary care, accounting, tax, legal, food-safety, emergency-management, or regulatory advice.</p>
    </div>
    <div class="callout-card">
      <p class="eyebrow">Corrections and support</p>
      <h3>Found something inaccurate or outdated?</h3>
      <p>Email <a class="text-link" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>. Include the page, app version, and the detail that needs review so Quiet Tools LLC can investigate and correct it.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="about-links-title">
    <SectionHeader headingId="about-links-title" eyebrow="Learn more" title="Product, privacy, and support information" />
    <InternalLinkCards links={[
      { title: 'Product tour', href: '/more-info', summary: 'See features, screenshots, workflows, reviews, and pricing in one detailed tour.' },
      { title: 'Privacy', href: '/privacy', summary: 'Read how local records, optional iCloud sync, support requests, and third-party services are handled.' },
      { title: 'Support', href: '/support', summary: 'Ask a product question, report a bug, request a feature, or share workflow feedback.' },
    ]} />
  </section>

  <CTA title="See what Homestead Keeper can organize." body="Explore the records, planning tools, workflows, and reports available across iPhone, iPad, and Mac." primaryLabel="View features" primaryHref="/features" secondaryLabel="Read the FAQ" secondaryHref="/faq" />
</Layout>
